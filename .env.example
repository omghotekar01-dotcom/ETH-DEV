# RIFT World 003 -- LOCAL TRAINING MODE works without any of these.
PORT=3000
# Private operator access token. Use a long random secret; do not commit it.
RIFT_ACCESS_TOKEN=
# 0G Private Computer, from your ETHGlobal 0G workshop allocation
OG_API_KEY=
OG_MODEL=
# 0G Storage TESTNET, funded testnet key. These files are public on testnet.
OG_STORAGE_PRIVATE_KEY=
OG_STORAGE_RPC=https://evmrpc-testnet.0g.ai
OG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
# Arkiv Rabdi testnet access token and funded tGLM account.
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=
# Hedera testnet agent payer + payee (separate accounts recommended).
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_SERVICE_ACCOUNT_ID=
HEDERA_ALLOWED_PAY_TO=
# Merchant runs separately on localhost:4021 by default; HTTPS remote host also accepted.
RIFT_MERCHANT_PORT=4021
RIFT_X402_ENDPOINT=http://127.0.0.1:4021/intel
RIFT_X402_ALLOWED_HOST=127.0.0.1
RIFT_X402_MAX_UNITS=1000
X402_TESTNET_FACILITATOR_URL=https://x402.org/facilitator
# EXPLICIT OPT-IN: only enable when funded testnet wallets + merchant are tested.
# Live spending is DENIED in serverless Vercel environments.
RIFT_ENABLE_LIVE_PAYMENTS=false
